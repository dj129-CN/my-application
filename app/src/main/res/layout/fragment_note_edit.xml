<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationContentDescription="@string/cd_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/edit_title_new"
            app:titleTextAppearance="@style/TextAppearance.NoteFlow.ToolbarTitle" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/editLoading"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="@color/note_surface_variant"
            app:trackCornerRadius="0dp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_horizontal_padding"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/screen_horizontal_padding"
                android:paddingBottom="@dimen/space_16">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/titleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/edit_hint_title"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium"
                    app:boxStrokeColor="?attr/colorOutline"
                    app:boxStrokeWidthFocused="2dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/titleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLength="80"
                        android:maxLines="1"
                        android:paddingTop="@dimen/space_16"
                        android:paddingBottom="@dimen/space_16"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        tools:text="把灵感留在当下" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/contentLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="@string/edit_hint_content"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium"
                    app:boxStrokeColor="?attr/colorOutline"
                    app:boxStrokeWidthFocused="2dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/contentInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="10000"
                        android:minLines="10"
                        android:paddingTop="@dimen/space_16"
                        android:paddingBottom="@dimen/space_16"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        tools:text="记录今天读到的一句话，以及它为什么打动我。" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/editMeta"
                    style="@style/TextAppearance.NoteFlow.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/edit_meta_new" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/space_16">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/action_save"
                android:textSize="16sp"
                app:cornerRadius="@dimen/radius_medium" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
