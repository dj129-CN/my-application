<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Test-only probe used by TodoContentProviderTest. It runs in a
            separate process so the test exercises a real Binder boundary when
            it reads and writes the todo ContentProvider.
        -->
        <service
            android:name=".provider.TodoProviderProbeService"
            android:exported="false"
            android:process=":todoProbe" />
    </application>

</manifest>
